# Copy to ".env" (python scripts/dev.py setup does this for you) and edit.
# ".env" is git-ignored: NEVER commit it, and never put real secrets in THIS example file.
# Real environment variables always win over values in .env.
# Relative paths are relative to the repository root.

# ---------------------------------------------------------------- API (local mode)
# Folder containing the trained model (config.json, model.safetensors, tokenizer files).
# `python scripts/dev.py train` writes model_out/v1; `scripts/fetch_model.py` unpacks to the same place.
MODEL_DIR=model_out/v1
# Returned in the X-Model-Version response header.
MODEL_VERSION=v1
# Maximum tokens the model may generate per request.
MAX_NEW_TOKENS=64
# CPU threads PyTorch uses while serving.
TORCH_THREADS=2
# Address the local server binds to. 127.0.0.1 = this computer only (safe default).
HOST=127.0.0.1
PORT=8000
# Testing only: 1 forces an invalid reply so you can see the HTTP 500 error path.
FAULT_INJECT=0

# ---------------------------------------------------------------- Training data / teacher (optional)
# Ollama server used to label commands with the teacher model (scripts/label_local.py).
OLLAMA_URL=http://localhost:11434
TEACHER_MODEL=phi3.5
# Where model downloads from object storage are cached (default: a temp folder).
# MODEL_CACHE_DIR=

# ---------------------------------------------------------------- Kubernetes / S3 mode (optional, advanced)
# Leave MODEL_URI empty for local mode. If set, the API downloads the model from S3 at start-up.
MODEL_URI=
S3_ENDPOINT=
# Credentials: leave blank here. scripts/make_secrets.sh generates them into .secrets/s3.env
# (git-ignored) and Kubernetes Secrets; do not paste real keys into this file if you share it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
